          </UniformRandomTimer>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract final_amount" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">final_amount</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.final_amount</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">FINAL_AMOUNT_NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="04 Assert amount hợp lệ (discount &gt;= 0, final &lt;= total)" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
try {
    def r = new JsonSlurper().parseText(prev.getResponseDataAsString())
    def total = new BigDecimal(vars.get("price"))
    if (r.final_amount == null || r.discount_amount == null) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage("Thiếu final_amount hoặc discount_amount")
    } else if (new BigDecimal(r.discount_amount.toString()) &lt; 0 || new BigDecimal(r.final_amount.toString()) &gt; total) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage("Sai số tiền: code=" + vars.get("code") + ", total=" + total + ", discount=" + r.discount_amount + ", final=" + r.final_amount)
    }
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Response không phải JSON: " + e.getMessage())
}
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
