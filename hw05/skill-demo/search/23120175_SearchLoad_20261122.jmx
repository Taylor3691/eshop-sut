<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="23120175_SearchLoad_20261122" enabled="true">
      <stringProp name="TestPlan.comments">Load demo nhóm read-heavy: GET /api/categories → GET /api/products?search= → GET /api/products/:id. Không login, không setUp lockout. Mặc định 30 thread, ramp-up 10 s, duration 120 s (scheduler, gồm ramp-up), think-time Uniform Random 0–50 ms trước bước 02 và 03. Chạy kèm -Jhttpclient.reset_state_on_thread_group_iteration=false. Tham số -J: host, port, threads, rampup, duration, think_min, think_range, keywords_csv, products_csv.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
