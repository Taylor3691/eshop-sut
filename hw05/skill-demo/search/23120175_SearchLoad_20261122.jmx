          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="02 Assert search matches expect_hit" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
try {
    def raw = prev.getResponseDataAsString()
    def parsed = new JsonSlurper().parseText(raw)
    if (!(parsed instanceof List)) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage("Search không trả mảng JSON")
        return
    }
    def keyword = vars.get("keyword")
    def expect = vars.get("expect_hit")
    def kw = keyword == null ? "" : keyword.toLowerCase(java.util.Locale.ROOT)
    boolean namesOk = true
    for (item in parsed) {
        def name = item?.name == null ? "" : item.name.toString().toLowerCase(java.util.Locale.ROOT)
        if (!name.contains(kw)) {
            namesOk = false
        }
    }
    if (expect == "1") {
        if (parsed.isEmpty() || !namesOk) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage("Kỳ vọng có kết quả cho '" + keyword + "', nhận n=" + parsed.size())
        }
    } else if (expect == "0") {
        if (!parsed.isEmpty()) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage("Kỳ vọng rỗng cho '" + keyword + "', nhận n=" + parsed.size())
        }
    } else {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage("expect_hit không hợp lệ: " + expect)
    }
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Response không phải JSON: " + e.getMessage())
}
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
