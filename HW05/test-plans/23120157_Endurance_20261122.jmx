        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="05 - Checkout">
          <stringProp name="TestPlan.comments">Verified POST /api/checkout; creates a persistent pending SQLite order. One checkout per virtual user/plan iteration.</stringProp>
